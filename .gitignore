# P09_StateHandoff repository: docs + the UE project in StateHandoff/.
# Generated by Unreal / Visual Studio. Never commit.
StateHandoff/Binaries/
StateHandoff/Intermediate/
StateHandoff/Saved/
StateHandoff/DerivedDataCache/
StateHandoff/Build/
StateHandoff/Plugins/*/Binaries/
StateHandoff/Plugins/*/Intermediate/
StateHandoff/.vs/
StateHandoff/*.sln
StateHandoff/*.slnx
*.VC.db
*.opensdf
*.sdf
*.suo

# Python
__pycache__/

# Packaged builds stay out of git.
Build/

# Benchmarks: raw captures, run reports and logs stay local (too large for git; UE logs also hold
# machine-specific paths). Manifests and Summaries/ are committed; cited raw batches go to GitHub Releases.
Benchmarks/Raw/*
!Benchmarks/Raw/*_manifest.json
Benchmarks/*_console.txt

# Parked drafts (code or docs not yet in the tree); never committed.
_wip/

# Portfolio export for sharing (images, description, demo video); not part of the repository.
Portfolio/
